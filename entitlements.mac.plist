<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Разрешить доступ к сети -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	
	<!-- Разрешить доступ к файловой системе -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	
	<!-- Разрешить доступ к домашней директории пользователя -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	
	<!-- Разрешить выполнение неподписанного исполняемого кода (для расширений браузера) -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	
	<!-- Разрешить JIT компиляцию (может понадобиться для некоторых библиотек) -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	
	<!-- Разрешить доступ к системным расширениям (для tray и других функций) -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
