{
  "name": "linkshelf",
  "version": "1.0.0",
  "description": "Quick-access link manager with site previews for macOS",
  "private": true,
  "main": "main.cjs",
  "author": "k.pichugin",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && FORCE_DEV=1 ELECTRON_DISABLE_SECURITY_WARNINGS=1 electron .\"",
    "build": "vite build && node fix-paths.js && electron-builder --mac",
    "build:renderer": "vite build && node fix-paths.js",
    "start": "ELECTRON_DISABLE_SECURITY_WARNINGS=1 electron ."
  },
  "dependencies": {  
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^6.0.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.linkshelf.app",
    "productName": "LinkShelf",
    "asar": true,
    "files": [
      "renderer/**/*",
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    }
  }
}
